{
  "name": "opencode-git-workbench",
  "version": "0.1.0",
  "description": "Git changes, commit and history graph panel for OpenCode Desktop",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "keywords": [
    "opencode",
    "plugin",
    "git"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "solid-js": "^1.9.17",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.14"
  }
}
